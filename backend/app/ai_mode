import re
from typing import Any


BAD_KEYWORDS = [
    "reprint",
    "2nd print",
    "3rd print",
    "facsimile",
    "reader copy",
    "damaged",
    "poor",
    "low grade",
    "random lot",
]

GOOD_KEYWORDS = [
    "1st print",
    "first print",
    "full run",
    "full set",
    "complete set",
    "nm",
    "near mint",
    "vf",
    "high grade",
]


def detect_issues(text: str) -> list[int]:
    text = text.lower()

    range_match = re.search(r"#\s*(\d+)\s*[-–]\s*(\d+)", text)
    if range_match:
        start = int(range_match.group(1))
        end = int(range_match.group(2))
        if start <= end:
            return list(range(start, end + 1))

    singles = re.findall(r"#\s*(\d+)", text)
    return sorted({int(x) for x in singles})


def estimate_value(title: str, detected_issues: list[int], condition: str | None = None) -> float:
    title_lower = title.lower()
    issue_count = max(1, len(detected_issues))

    base_per_issue = 22.0
    if "#1" in title_lower:
        base_per_issue += 20.0
    if "absolute batman" in title_lower:
        base_per_issue += 10.0
    if "1st print" in title_lower or "first print" in title_lower:
        base_per_issue += 8.0
    if "nm" in title_lower or "near mint" in title_lower:
        base_per_issue += 4.0
    if condition:
        cond = condition.lower()
        if "near mint" in cond or "nm" in cond:
            base_per_issue += 4.0
        elif "vf" in cond:
            base_per_issue += 2.0

    run_bonus = 0.0
    if issue_count >= 3:
        run_bonus = issue_count * 2.0

    return round((base_per_issue * issue_count) + run_bonus, 2)


def analyze_listing(payload: dict[str, Any]) -> dict[str, Any]:
    title = str(payload.get("title", "")).strip()
    price = float(payload.get("price", 0) or 0)
    shipping = float(payload.get("shipping", 0) or 0)
    condition = payload.get("condition")
    seller_feedback = float(payload.get("seller_feedback", 0) or 0)

    text = f"{title} {condition or ''}".lower()
    issues = detect_issues(text)
    total_cost = price + shipping

    good_hits = [k for k in GOOD_KEYWORDS if k in text]
    bad_hits = [k for k in BAD_KEYWORDS if k in text]

    first_print_confidence = 0.25
    if "1st print" in text or "first print" in text:
        first_print_confidence += 0.35
    if "#1" in text:
        first_print_confidence += 0.10
    if "full run" in text or "complete set" in text:
        first_print_confidence += 0.10
    if bad_hits:
        first_print_confidence -= 0.20
    first_print_confidence = max(0.0, min(1.0, first_print_confidence))

    estimated_value = estimate_value(title, issues, condition)
    ebay_fee = estimated_value * 0.13
    resale_shipping_cost = 5.0
    profit = round(estimated_value - ebay_fee - resale_shipping_cost - total_cost, 2)
    roi = round((profit / total_cost) * 100, 2) if total_cost > 0 else 0.0

    score = 50
    if profit > 25:
        score += 20
    elif profit > 10:
        score += 10
    if roi > 25:
        score += 15
    elif roi > 10:
        score += 8
    if seller_feedback >= 99:
        score += 5
    if good_hits:
        score += min(10, len(good_hits) * 2)
    if bad_hits:
        score -= min(25, len(bad_hits) * 8)

    score = max(0, min(100, score))

    if score >= 75 and profit > 15:
        recommendation = "BUY"
    elif score >= 55 and profit > 0:
        recommendation = "MAYBE"
    else:
        recommendation = "PASS"

    reasoning = []
    if issues:
        reasoning.append(f"Detected issues: {issues}")
    if len(issues) >= 3:
        reasoning.append("Listing appears to be a run or set.")
    if "1st print" in text or "first print" in text:
        reasoning.append("First-print wording detected.")
    if bad_hits:
        reasoning.append(f"Risk flags: {', '.join(bad_hits)}.")
    if profit > 0:
        reasoning.append("Estimated resale value suggests profit potential.")
    else:
        reasoning.append("Estimated resale value does not leave enough margin.")

    return {
        "normalized_query": title,
        "is_full_run": len(issues) >= 3,
        "issues_detected": issues,
        "first_print_confidence": round(first_print_confidence, 2),
        "risk_flags": bad_hits,
        "estimated_value": estimated_value,
        "total_cost": round(total_cost, 2),
        "profit": profit,
        "roi": roi,
        "score": score,
        "recommendation": recommendation,
        "reasoning": reasoning,
    }
