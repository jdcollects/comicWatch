from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from .schemas import ListingInput
from .ai_mode import analyze_listing

app = FastAPI(title="Comic Deal Sniper AI Backend", version="1.0.0")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

@app.get("/health")
def health():
    return {"status": "ok", "mode": "ai_only"}

@app.post("/ai/analyze")
def ai_analyze(payload: ListingInput):
    return analyze_listing(payload.model_dump())
